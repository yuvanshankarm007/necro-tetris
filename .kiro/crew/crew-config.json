{
  "name": "Defrag84 System Daemons",
  "version": "2.0.0",
  "description": "Multi-agent crew powering the autonomous memory garbage collector, chaos load injector, and real-time heap profiler for Defrag84.",
  "agents": [
    {
      "id": "gc-optimizer",
      "name": "The GC Optimizer",
      "role": "Autonomous 2D Bin-Packing Compaction Daemon",
      "config": "./architect-ghost.json"
    },
    {
      "id": "chaos-monkey",
      "name": "The Chaos Monkey",
      "role": "Memory Leak & Container Failure Injector",
      "config": "./poltergeist.json"
    },
    {
      "id": "memory-profiler",
      "name": "The Memory Profiler",
      "role": "Heap Observability & Diagnostics Daemon",
      "config": "./gravedigger.json"
    }
  ],
  "collaboration_mode": "asynchronous_event_driven",
  "event_triggers": [
    "heap_init",
    "page_ingress",
    "gc_compaction",
    "fragmentation_spike",
    "oom_warning",
    "kernel_panic"
